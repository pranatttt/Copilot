# --- PROJECT METADATA ---
PROJECT_NAME="EY Compliance Navigator"
API_V1_STR="/api/v1"

# --- AZURE OPENAI PROXY CONFIG ---
# Replace with your actual credentials

AZURE_OPENAI_API_KEY="your_api_key_here"

AZURE_OPENAI_ENDPOINT="https://func-quotamonitor-sbx.azurewebsites.net/api/v1"

AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o-mini"

AZURE_OPENAI_API_VERSION="2024-02-01"


# --- DATABASE CONFIG (DOCKER) ---
# 'db' is the service name in docker-compose.yml

POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=ey_compliance
POSTGRES_PORT=5432

# Database URL

DATABASE_URL=postgresql://postgres:postgres_password_here@db:5432/ey_compliance


# --- SECURITY ---
# Change in production

SECRET_KEY="replace_with_secure_key"

CURL_CA_BUNDLE=""
PYTHONHTTPSVERIFY=0
