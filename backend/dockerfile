# 1. Use a slim version of Python for a smaller, faster, and more secure image
FROM python:3.11-slim

# 2. Set the working directory inside the container
WORKDIR /app

# 3. Install essential system dependencies (needed for Postgres and some AI libraries)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 4. Copy ONLY the requirements file first to take advantage of Docker layer caching
# This makes subsequent builds MUCH faster
COPY requirements.txt .

# 5. Install the Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# 6. Copy the rest of your backend code into the container
COPY . .

# 7. Expose the port FastAPI will run on
EXPOSE 8000

# 8. Command to run the application using Uvicorn
# --reload allows for "hot-reloading" during development
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
